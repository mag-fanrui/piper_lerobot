# 平滑性参数（单一口径）
#
# 正式实验的默认值统一在这里定义，deploy_piper.sh 启动时 source 本文件，
# run_batch.py 批量开跑前也会打印这里的内容，保证「单条跑」和「批量跑」口径一致。
#
# 改动这里的值 = 改掉所有后续实验的默认行为；单次覆盖仍可用同名环境变量，例如
#   JOINT_ALPHA=0.3 TRIAL_ID=T010 bash scripts/deploy_piper.sh
#
# 说明（对应 piper_follower 的部署参数）：
#   MAX_STEP_RAD    每步关节限幅（rad）——越小越稳、跟踪越滞后
#   JOINT_ALPHA     关节 EMA 平滑系数（1.0 = 关闭）——越小越平滑、滞后越大
#   GRIPPER_ALPHA   夹爪 EMA 平滑系数
#   N_ACTION_STEPS  每个 chunk 实际执行的动作步数（chunk_size 保持 50 不覆盖）

MAX_STEP_RAD_DEFAULT=0.05
JOINT_ALPHA_DEFAULT=0.15
GRIPPER_ALPHA_DEFAULT=0.4
N_ACTION_STEPS_DEFAULT=50
